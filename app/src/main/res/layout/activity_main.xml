<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#121212">

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BrainQuiz"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#BB86FC"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦ Test Your Knowledge ✦"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="48dp"/>

    <TextView
        android:id="@+id/tvSelectLanguage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Language"
        android:textSize="16sp"
        android:textColor="#BBBBBB"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgLanguage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <RadioButton
            android:id="@+id/rbEnglish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="English"
            android:textColor="#FFFFFF"
            android:buttonTint="#BB86FC"
            android:layout_marginEnd="16dp"/>

        <RadioButton
            android:id="@+id/rbArabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="عربي"
            android:textColor="#FFFFFF"
            android:buttonTint="#BB86FC"/>

    </RadioGroup>

    <TextView
        android:id="@+id/tvSelectLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Level"
        android:textSize="16sp"
        android:textColor="#BBBBBB"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="48dp">

        <RadioButton
            android:id="@+id/rbEasy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Easy"
            android:textColor="#03DAC6"
            android:buttonTint="#03DAC6"
            android:layout_marginEnd="8dp"/>

        <RadioButton
            android:id="@+id/rbMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medium"
            android:textColor="#FFB74D"
            android:buttonTint="#FFB74D"
            android:layout_marginEnd="8dp"/>

        <RadioButton
            android:id="@+id/rbHard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hard"
            android:textColor="#FF5252"
            android:buttonTint="#FF5252"/>

    </RadioGroup>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="200dp"
        android:layout_height="52dp"
        android:text="Start Game"
        android:textSize="18sp"
        android:textColor="#000000"
        android:backgroundTint="#BB86FC"
        android:stateListAnimator="@null"/>

</LinearLayout>